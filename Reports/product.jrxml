	<query language="sql"><![CDATA[SELECT * FROM `product` INNER JOIN `brand` ON `product`.`brand_id` = `brand`.`id` 
INNER JOIN `unit` ON `product`.`unit_id` = `unit`.`id` 
INNER JOIN `model` ON `product`.`model_id` = `model`.`id` 
INNER JOIN `status` ON `product`.`status_id` = `status`.`id`]]></query>
