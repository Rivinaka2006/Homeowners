	<query language="sql"><![CDATA[SELECT * FROM `user` INNER JOIN `user_type` ON `user_type`.`id` = `user`.`user_type_id`
INNER JOIN `gender` ON `gender`.`id` = `user`.`gender_id`
INNER JOIN `status` ON `status`.`id` = `user`.`status_id`]]></query>
