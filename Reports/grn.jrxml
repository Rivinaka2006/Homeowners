	<query language="sql"><![CDATA[SELECT * FROM `grn` INNER JOIN `user` ON `grn`.`user_id` = `user`.`id` 
INNER JOIN `supplier` ON `grn`.`supplier_id` = `supplier`.`id` 
INNER JOIN `grn_item` ON `grn_item`.`grn_id` = `grn`.`id` 
INNER JOIN `stock` ON `grn_item`.`stock_id` = `stock`.`id`]]></query>
